# .env.example — Vorlage für lokale Credentials
#
# Plan 2026-07-09: HF_TOKEN wird lokal in .env gespeichert statt
# in der Shell exportiert. push_hf.sh sourced diese Datei automatisch.
#
# Setup:
#   1. cp .env.example .env
#   2. Trage deinen echten HF_TOKEN in .env ein
#   3. .env ist in .gitignore — wird NIE committed
#
# Token-Scope: write auf User-Account (sonst push schlägt fehl mit 403)

# HF-Space write-Token (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Space-Name überschreiben (Default: px-explorer-v4 in push_hf.sh)
# SPACE_NAME=px-explorer-v5
